{
  "name": "upag-js",
  "version": "1.0.4",
  "description": "Official Upag JavaScript SDK for frontend applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/upag.js",
  "jsdelivr": "./dist/upag.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "license": "MIT",
  "keywords": [
    "upag",
    "payment",
    "checkout",
    "subscription",
    "billing",
    "sdk",
    "frontend",
    "browser",
    "javascript",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upaghq/upag-js.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || git config core.hooksPath .githooks || true",
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "dev": "tsup --watch",
    "test": "vitest",
    "check:bundle": "node ./scripts/check-bundle.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jsdom": "^29.0.0",
    "msw": "^2.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
